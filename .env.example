# Copy this file to ".env" and fill it in. Every line is optional.

# --- AI brain: Groq is the main one (free, very fast). Grok and OpenRouter are optional extra backups ---
GROQ_API_KEY=                  # from https://console.groq.com/keys  (starts with gsk_)
GROQ_MODEL=auto                # auto = best chat model your key can use (or e.g. llama-3.3-70b-versatile; commas = fallback list)
XAI_API_KEY=                   # optional: Grok - from https://console.x.ai   (NOT the place for a Groq key)
GROK_MODEL=auto
OPENROUTER_API_KEY=           # optional: from https://openrouter.ai/keys - only its ":free" models are used
OPENROUTER_MODEL=auto
JARVIS_AI=auto                 # auto (Groq, Grok, then OpenRouter) | groq | grok | openrouter
# No key at all? Every command (open, search, mail, PC control, stop...) still works; only open-ended chat is limited.

# --- speech to text (what Jarvis hears) ---
JARVIS_STT=auto                # auto = Groq Whisper when GROQ_API_KEY is set (much better accuracy), else Google | groq | google
JARVIS_STT_MODEL=whisper-large-v3-turbo

# --- websites ---
JARVIS_BROWSER=chrome          # chrome | edge | firefox | brave | default  - where "open instagram" etc. opens
JARVIS_SOCIAL=facebook,instagram,whatsapp,twitter,linkedin,youtube    # what "open all social media" opens
JARVIS_STREAM=true             # speak the answer sentence by sentence while the AI is still writing it

JARVIS_USER_NAME=Zaeem
JARVIS_CREATOR=Zaeem
JARVIS_CITY=Sargodha
JARVIS_NEWS_REGION=PK
JARVIS_LANGUAGE=en-US          # try en-PK or en-IN if recognition struggles with your accent

JARVIS_WAKE_WORD=true          # false = always listening, no need to say "Jarvis"
JARVIS_FOLLOW_UP_SECS=12       # after a reply you can keep talking without the wake word for this long

JARVIS_TTS=auto                # auto | edge | system | off
JARVIS_VOICE=en-US-GuyNeural  # other: en-GB-RyanNeural, en-GB-ThomasNeural, en-IN-PrabhatNeural
JARVIS_VOICE_RATE=+6%

JARVIS_MIC=1                    # microphone number or name (run: python jarvis.py --devices)
JARVIS_VAD_MIN=220             # raise (e.g. 400) in noisy rooms, lower (e.g. 120) for a quiet mic
JARVIS_LITE=false              # true = lighter animation for very old PCs
JARVIS_FULLSCREEN=false
JARVIS_FORCE_OFFLINE=false

# --- new in this version ---
JARVIS_BARGE_IN=true           # keep listening while Jarvis talks, so "stop" / "Jarvis closed" work. false = only the STOP button/Esc
JARVIS_BARGE_SENS=2.2          # raise (3-4) if he interrupts himself through your speakers; headphones fix it completely
JARVIS_CONTEXT_SECS=600        # "search X" / "close it" stay linked to the last app or site for this long
JARVIS_BACKGROUND=false        # true = start with no window (voice only)
JARVIS_CLOSE_TO_BACKGROUND=true  # the window's X button hides Jarvis instead of quitting him
JARVIS_MAIL=gmail              # gmail | outlook | default  (used by "compose a new mail")

